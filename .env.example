# Copy to .env and fill in. .env is git-ignored - never commit real keys.

# Anthropic API key for the `api` judge backend (leave empty to use the logged-in Claude Code CLI)
ANTHROPIC_API_KEY=

# Optional overrides
# JUDGE_MODEL=claude-opus-5-5
# JUDGE_BACKEND=auto        # auto | api | cli
# CLAUDE_BIN=               # path to the claude executable if it is not on PATH
