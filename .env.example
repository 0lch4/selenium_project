# Copy to .env and fill in. .env is git-ignored - never commit real keys.

# Anthropic API key (sk-ant-api...) for the `api` judge backend, from console.anthropic.com.
# Leave empty to use the logged-in Claude Code CLI.
ANTHROPIC_API_KEY=

# Optional: Claude Code token from `claude setup-token` (sk-ant-oat...) for the `cli` backend,
# e.g. when Claude Code is not logged in on this machine. Not an API key.
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional overrides
# JUDGE_MODEL=claude-opus-5-5
# JUDGE_BACKEND=auto        # auto | api | cli
# CLAUDE_BIN=               # path to the claude executable if it is not on PATH
